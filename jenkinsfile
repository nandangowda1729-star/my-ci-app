pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m venv venv
                    ./venv/bin/pip install --upgrade pip
                    ./venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh './venv/bin/pytest -v'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t flask-ci-app .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                    docker rm -f flask-ci-container || true
                    docker run -d \
                        --name flask-ci-container \
                        -p 5000:5000 \
                        flask-ci-app
                '''
            }
        }

        stage('Verify Application') {
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:5000/
                '''
            }
        }
    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
        }

        failure {
            echo 'CI Pipeline failed!'
        }

        always {
            sh 'docker rm -f flask-ci-container || true'
        }
    }
}
